{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDLQB Setup",
  "version": "0.1.0",
  "identifier": "com.supersoft.gdlqb-installer",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Setup",
        "width": 600,
        "height": 492,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
