{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GD Level Request Bot",
  "version": "0.1.0",
  "identifier": "com.supersoft.gdlqb",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml -p gdlqbot-cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release --manifest-path src-tauri/Cargo.toml -p gdlqbot-cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GD Level Request Bot",
        "width": 800,
        "height": 600,
        "visible": false,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Supernova Software, LLC",
    "externalBin": [
      "binaries/gdlqbcli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gdlqs"
        ],
        "name": "GDLQScript",
        "description": "GD Level Queue Bot command script"
      },
      {
        "ext": [
          "gdmod"
        ],
        "name": "GDLQBotModule",
        "description": "GD Level Request Bot module package"
      },
      {
        "ext": [
          "gdpck"
        ],
        "name": "GDLQBotPackage",
        "description": "GD Level Request Bot package bundle"
      },
      {
        "ext": [
          "gdlib"
        ],
        "name": "GDLQBotLibrary",
        "description": "GD Level Request Bot library package"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQzgyOUJDMTNFRDU5MjEKUldRaFdlMFR2Q25JclZUYUdZd0xHbGFuWjlCZDhnVWsvWGtscDloSGRLcHg1NzRXR0cvVzVTejAK",
      "endpoints": [
        "https://dl.supers0ft.us/gdlvlreqbot/updates/"
      ],
      "dialog": false,
      "windows": {
        "installMode": "basicUi",
        "installerArgs": [
          "--silent",
          "--accept-license",
          "--kill-running"
        ]
      }
    }
  }
}
