{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GD Level Request Bot",
  "version": "0.0.7",
  "identifier": "com.supersoft.gdlqb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GD Level Request Bot",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Supernova Software, LLC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gdlqs"
        ],
        "name": "GDLQScript",
        "description": "GD Level Queue Bot command script"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQzgyOUJDMTNFRDU5MjEKUldRaFdlMFR2Q25JclZUYUdZd0xHbGFuWjlCZDhnVWsvWGtscDloSGRLcHg1NzRXR0cvVzVTejAK",
      "endpoints": [
        "https://dl.supers0ft.us/gdlvlreqbot/updates/"
      ],
      "dialog": true
    }
  }
}
